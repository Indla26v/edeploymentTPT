# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres: both URLs can be the same.
DATABASE_URL=postgresql://edeploy:edeploy@localhost:5432/edeployment
DATABASE_URL_UNPOOLED=postgresql://edeploy:edeploy@localhost:5432/edeployment

# Neon project "edeployment" (AWS Singapore, aws-ap-southeast-1). Use the `dev` branch for local work and
# `main` for production. Copy both URLs from the Neon console → Connect (or `vercel env pull .env.local`).
#   DATABASE_URL           pooled connection ("-pooler" in the host)  → the running app
#   DATABASE_URL_UNPOOLED  direct connection                          → migrations, seed, drizzle-kit
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Separate database used by `pnpm test` (migrated and re-seeded by the test suite). Keep this local
# or point it at a throwaway Neon branch — never at a database you care about.
TEST_DATABASE_URL=postgresql://edeploy:edeploy@localhost:5432/edeployment_test

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used for cookies and origin checks)
BETTER_AUTH_URL=http://localhost:3000
# Show the demo account chips on the login page (development only — never in production)
SHOW_DEMO_ACCOUNTS=true

# Protects /api/cron/tick (auto-accept overdue requests, reminders, message outbox). Any long random string.
CRON_SECRET=
# Message delivery: console (default) until an SMS / WhatsApp provider is added.
OUTBOX_PROVIDER=console

# State Admins must use two-step sign-in. Set to false only for local demos / CI.
REQUIRE_ADMIN_2FA=true
